<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Spektrafilm LrC-Exp" Background="#212325" Foreground="#E2E4E7"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True" ToolTipService.IsEnabled="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="3" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#505256" BorderThickness="1" TextElement.Foreground="{StaticResource Text}"
            TextElement.FontFamily="Segoe UI, Microsoft YaHei UI" TextElement.FontSize="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="37"/><RowDefinition Height="*"/><RowDefinition Height="83"/><RowDefinition Height="44"/>
            </Grid.RowDefinitions>
            <Border Name="TitleBar" Background="#202224" BorderBrush="#151618" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Name="Minimize" Style="{StaticResource TitleButton}" Content="−" ToolTip="最小化" AutomationProperties.Name="最小化"/>
                        <Button Name="Maximize" Style="{StaticResource TitleButton}" Content="□" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原"/>
                        <Button Name="Close" Style="{StaticResource TitleButton}" Content="×" ToolTip="关闭工作区" AutomationProperties.Name="关闭工作区"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Background="#ADBFD3" Width="16" Height="13" CornerRadius="1" Margin="0,0,9,0">
                            <Grid Margin="2"><Border Background="#343D48" Height="6" VerticalAlignment="Center"/>
                                <TextBlock Text="▪ ▪ ▪" Foreground="#343D48" FontSize="5" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Spektrafilm" Foreground="#E2E4E7" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="LrC-Exp" Foreground="#9EA2A8" FontSize="12" Margin="8,1,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="4"/>
                    <ColumnDefinition Name="RailWidth" Width="342" MinWidth="265" MaxWidth="550"/></Grid.ColumnDefinitions>
                <Grid Background="#242628">
                    <Grid.RowDefinitions><RowDefinition Height="33"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Background="#292B2D" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Name="Position" Foreground="#B5B8BD" Margin="8,0,12,0"/>
                        <TextBlock Name="FileName" Text="照片预览" Foreground="#E2E4E7" FontWeight="SemiBold" Margin="12,0,6,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Border Name="Stage" Grid.Row="1" Background="#242628" ClipToBounds="True" Padding="12">
                        <Grid>
                            <Image Name="Preview" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Grid Name="ReferenceLayer" Background="#242628" Visibility="Collapsed" IsHitTestVisible="False">
                                <Image Name="ReferenceImage" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <Border Name="ReferenceLine" Width="1" HorizontalAlignment="Left" Background="White"
                                    Visibility="Collapsed" IsHitTestVisible="False"/>
                            <TextBlock Name="Empty" Text="在 Lightroom Classic 中选择照片" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="#9EA2A8"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Background="#292B2D" Padding="8,6">
                        <StackPanel>
                            <WrapPanel>
                                <Button Name="Previous" Content="‹" Width="29" Margin="0,0,3,2" ToolTip="上一张 (←)"/>
                                <Button Name="Next" Content="›" Width="29" Margin="0,0,10,2" ToolTip="下一张 (→)"/>
                                <Button Name="Fit" Content="适合" Margin="0,0,3,2" ToolTip="适合窗口"/>
                                <Button Name="Loupe" Content="100%" Margin="0,0,12,2" ToolTip="原尺寸局部"/>
                                <Button Name="After" Content="成片" Margin="0,0,3,2"/>
                                <Button Name="Before" Content="原图" Margin="0,0,3,2" ToolTip="LrC 基础调整后的照片"/>
                                <Button Name="Split" Content="分割" Margin="0,0,12,2"/>
                                <Button Name="Pin" Content="固定为 A" IsEnabled="False" Margin="0,0,6,2"/>
                                <Button Name="Histogram" Content="直方图" Margin="0,0,3,2"/>
                                <Button Name="Refresh" Content="刷新预览" Margin="0,0,0,2"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <GridSplitter Grid.Column="1" Width="4" Background="#1E2022" HorizontalAlignment="Stretch" ResizeDirection="Columns"/>
                <Border Grid.Column="2" Background="#303235">
                    <ScrollViewer Name="RailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Name="Rail">
                            <Border Name="HistogramPanel" Visibility="Collapsed" Background="#252729" Padding="10,6">
                                <StackPanel><TextBlock Text="RGB 直方图" Foreground="#B5B8BD"/>
                                    <Image Name="Chart" Stretch="Uniform" Height="68" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="12,0">
                                <StackPanel Name="CompareTools" Visibility="Collapsed" Margin="0,6">
                                    <TextBlock Text="左 A · 固定成片　　右 B · 当前配方"/>
                                    <Slider Name="ComparePosition" Minimum="0" Maximum="100" Value="50" IsMoveToPointEnabled="True"/>
                                </StackPanel>
                                <DockPanel Name="DividerRow" Visibility="Collapsed">
                                    <TextBlock DockPanel.Dock="Left" Text="分割位置" Margin="0,0,12,0"/>
                                    <Slider Name="Divider" Minimum="0" Maximum="100" Value="50" IsMoveToPointEnabled="True"/>
                                </DockPanel>
                                <Grid Name="RoiRow" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="中心 X" Margin="0,0,7,0"/><Slider Name="RoiX" Grid.Column="1" Minimum="0" Maximum="100" Value="50" IsMoveToPointEnabled="True"/>
                                    <TextBlock Text="Y" Grid.Column="2" Margin="10,0,7,0"/><Slider Name="RoiY" Grid.Column="3" Minimum="0" Maximum="100" Value="50" IsMoveToPointEnabled="True"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="#242628" BorderBrush="#161719" BorderThickness="0,1,0,1" Padding="8,4">
                <DockPanel>
                    <Button Name="BackPage" DockPanel.Dock="Left" Content="‹" Width="23" ToolTip="上一页缩略图"/>
                    <Button Name="NextPage" DockPanel.Dock="Right" Content="›" Width="23" ToolTip="下一页缩略图"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="4,0">
                        <StackPanel Name="Filmstrip" Orientation="Horizontal"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Row="3" Background="#202224" Padding="11,5">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Name="Queue" Content="导出记录" Margin="0,0,5,0"/>
                        <Button Name="Stop" Content="本项后停止" Margin="0,0,8,0" IsEnabled="False"/>
                        <Button Name="Export" Content="导出当前照片" Style="{StaticResource ExportButton}"
                                FontWeight="SemiBold" MinWidth="100" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock Name="Status" Text="正在读取照片…" TextTrimming="CharacterEllipsis" Foreground="#B4B7BB" Margin="0,0,8,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
